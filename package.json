{
  "name": "lombokunicode",
  "version": "0.1.0",
  "description": "Unicode algorithms with identical results across languages. 0.1.0: the Unicode Bidirectional Algorithm (UAX #9, Unicode 17.0.0) with Bidi_Class, mirroring and paired-bracket data, passing BidiTest and BidiCharacterTest. Zero dependencies.",
  "keywords": ["unicode", "bidi", "uax9", "rtl", "arabic", "hebrew", "mirroring", "zero-dependency", "lombok-ecosystem"],
  "license": "Apache-2.0",
  "author": "codinglombok (https://github.com/codinglombok)",
  "repository": { "type": "git", "url": "https://github.com/codinglombok/LombokUnicode.git" },
  "homepage": "https://github.com/codinglombok/LombokUnicode",
  "bugs": { "url": "https://github.com/codinglombok/LombokUnicode/issues" },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "files": ["dist", "LICENSE", "NOTICE", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest --run",
    "coverage": "vitest --run --coverage",
    "data": "python3 scripts/gen_data.py",
    "vectors": "python3 vectors/build_vectors.py",
    "doctor": "bash scripts/lombok-doctor.sh LombokUnicode",
    "check": "npm run lint && npm run coverage && npm run build && npm run doctor"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
